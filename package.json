{
  "name": "ai-movie-recap-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": "22.x"
  },
  "description": "Privacy-aware movie audio transcription and Myanmar subtitle rendering studio",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/index.js",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx test-step1.js",
    "test:e2e": "tsx e2e-step1.mjs",
    "test:e2e:live": "node proof/e2e-server-public.mjs",
    "preview": "vite preview --port 3000 --strictPort"
  },
  "dependencies": {
    "express": "5.3.0",
    "multer": "2.5.0"
  },
  "devDependencies": {
    "@fontsource/noto-sans-myanmar": "^5.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "0.469.0",
    "music-metadata": "^12.3.4",
    "playwright": "^1.49.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
